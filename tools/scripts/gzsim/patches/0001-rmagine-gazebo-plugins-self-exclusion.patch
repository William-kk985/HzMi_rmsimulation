+  // ── HzMi addition (our patch 0001, Fortress backend) ──────────────────────
+  // A sensor plugin can register the model entity that owns it here; the map
+  // system then excludes every visual below that entity from the BVH.  This
+  // is what makes "the robot must not see its own chassis" work without
+  // hard-coding a model name (Gazebo may suffix `<model name>` with `_0` when
+  // the same model is included twice, so a name-based `ignore_model` list is
+  // not reliable for a robot that appears more than once in a world).
+  void AddIgnoredModelEntity(gz::sim::Entity entity)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ignored_model_entities_.insert(entity);
+  }
+
+  void RemoveIgnoredModelEntity(gz::sim::Entity entity)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ignored_model_entities_.erase(entity);
+  }
+
+  bool IsIgnoredModelEntity(gz::sim::Entity entity) const
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return ignored_model_entities_.count(entity) != 0;
+  }
