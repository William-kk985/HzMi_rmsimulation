+  ignition-plugin1::register
+  ignition-transport11::ignition-transport11
+  ignition-msgs8::ignition-msgs8
   rmagine::core
   rmagine::embree)
 ament_target_dependencies(mid360_system
   ament_index_cpp builtin_interfaces rclcpp sensor_msgs std_msgs
   rmagine_gazebo_plugins)
 
+# RMAGINE_GZ_IGNITION_ERA selects IGNITION_ADD_PLUGIN instead of GZ_ADD_PLUGIN
+# (rmagine_gazebo_plugins' gz_compat.hpp reads it).  MID360_HAS_PHYSICS_BACKEND=0
+# disables the physics/`RaycastData` ray backend: gz-sim6 has no
+# components/RaycastData, so only the Embree backend exists on Fortress.
+target_compile_definitions(mid360_system PRIVATE
+  RMAGINE_GZ_IGNITION_ERA=1
+  MID360_HAS_PHYSICS_BACKEND=0)
+
 if(livox_ros_driver2_FOUND)
   target_compile_definitions(mid360_system PRIVATE MID360_HAS_LIVOX_CUSTOM_MSG=1)
   ament_target_dependencies(mid360_system livox_ros_driver2)
