+# ── HzMi patch (Fortress compat) ─────────────────────────────────────────────
+# Gazebo Fortress = ignition-gazebo6, the generation paired with ROS 2 Humble.
+# Upstream targets Harmonic (gz-sim8).  This block is the only build-side
+# difference; the C++ side differs in exactly two spots, both marked below.
+find_package(ignition-gazebo6 REQUIRED)
+find_package(ignition-plugin1 REQUIRED COMPONENTS register)
+find_package(ignition-transport11 REQUIRED)
+find_package(ignition-msgs8 REQUIRED)
 find_package(rmagine 2.3 REQUIRED COMPONENTS core embree)
 find_package(rmagine_gazebo_plugins REQUIRED)
 find_package(livox_ros_driver2 QUIET)
