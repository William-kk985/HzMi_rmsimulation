<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- 【需替换】模型名：和你的模型目录名一致 -->
  <model name='RMUL2026_world'>
    <!-- 静态模型必配，规范写法true -->
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>

    <link name='base_link'>
      <!-- 惯性参数：静态模型通用默认值，无需修改 -->
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>100.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>100.0</iyy>
          <iyz>0.0</iyz>
          <izz>100.0</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>

      <pose>0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <enable_wind>false</enable_wind>

      <!-- 视觉部分 -->
      <visual name='visual'>
        <!-- 【需替换】姿态：模型旋转不对时调整，默认0 -->
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <!-- 【需替换】STL路径：model://模型目录/meshes/STL文件名 -->
            <uri>model://RMUL2026_world/meshes/RMUL2026.stl</uri>
            <!-- 【需替换】缩放：模型大小不对时调整，默认1 -->
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>true</cast_shadows>
      </visual>

      <!-- 碰撞部分：保留核心，精简冗余 -->
      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUL2026_world/meshes/RMUL2026.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>