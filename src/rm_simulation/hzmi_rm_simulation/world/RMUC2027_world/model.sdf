<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- RMUC2027 场地模型（独立 model 入口，供 model://RMUC2027_world 直接 include；
       与 world/RMUC2027_world/RMUC2027_world.world 里内联的那份等价）。
       结构镜像 RMUC2026_world/model.sdf，差异只有两处（依据见 docs/worlds_2027.md §2.3b/§3.2b）：
         1. mesh 单位是毫米 ⇒ scale 0.001（与 world 内联那份一致）
         2. mesh 本来就是 Z 轴朝上 ⇒ 不需要旋转；低区地面在 mesh 局部 z=-1.700 m（局部平坦格众数），
            所以 pose 抬 +1.700 m 让地面落在 world z=0（RMUC2026 那份是 +1.6413436）
       注意：本场地**不是单一平面**：顶层高度四分位 -1.71/-1.48 m（中央高台 + 四条坡道 + 0.42 m 立墙），
       所以"地面在 z=0"只对低区成立，实测分布见 docs/worlds_2027.md §4.3。 -->
  <model name='RMUC2027_world'>
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>

    <link name='base_link'>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>100.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>100.0</iyy>
          <iyz>0.0</iyz>
          <izz>100.0</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>

      <pose>0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <enable_wind>false</enable_wind>

      <visual name='visual'>
        <pose>0 0 1.700 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUC2027_world/meshes/RMUC2027.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>true</cast_shadows>
      </visual>

      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 1.700 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUC2027_world/meshes/RMUC2027.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
