<sdf version='1.7'>
  <world name='default'>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <audio>
      <device>default</device>
    </audio>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <model name='RMUL_2027'>
      <link name='link_3'>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.166667</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.166667</iyy>
            <iyz>0</iyz>
            <izz>0.166667</izz>
          </inertia>
          <pose>0 0 0 0 -0 0</pose>
        </inertial>
        <pose>0 0 -3e-06 0 -0 0</pose>
        <gravity>1</gravity>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <enable_wind>0</enable_wind>
        <visual name='visual'>
          <!-- ★ 2027 场地（RMUL2027_3V3_V1.0.0.stp → gmsh 200 mm 三角化 → 二进制 STL）：
               与 RMUL2026 同一套约定，只有三处不同（推导/实测见 docs/worlds.md §9）：
                 · mesh 单位 mm ⇒ <scale>0.001；mesh 是 Y 轴朝上 ⇒ 绕 X 转 -90°（此处用精确的
                   -1.5707963，而 2026 那份写 -1.5705，差 0.3 mrad ≈ 全场 1.3 mm 倾斜，2027 这份不再引入）；
                 · mesh 的**可行驶地面**就是局部 y=0 平面（12600x8600 mm 里 5704/10836 个
                   0.1 m 栅格点顶层落在 y=0，另有 y=-3/-10 的 3~10 mm 薄装饰面）；
                   y 是**朝下**的（+y = 地面以下：100 mm 厚的底板底面在 y=+100，全部 108.36 m²；
                   场地立墙/台阶在地面**之上**，y 到 -420）。旋转后 world z = -y·0.001
                   ⇒ y=0 地面正好落在 z=0，**不需要任何 z 偏移**（model pose z 与 link pose z 都是 0）；
                 · 场地中心放在世界原点（mesh x → world x，mesh z → world y），
                   world 外框 x∈[-6.3,6.3]、y∈[-4.3,4.3]，与 RMUC2026 的"mesh 米制坐标==world 坐标"一致。
               本 world 文件里**内联**的这份是实际生效的资产；`model.sdf` 是 model://RMUL2027_world 的
               独立入口，两者数值一致。 -->
          <pose>0 0 0 -1.5707963 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://RMUL2027_world/meshes/RMUL2027.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <lighting>1</lighting>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <shader type='pixel'>
              <normal_map>__default__</normal_map>
            </shader>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
          <transparency>0</transparency>
          <cast_shadows>1</cast_shadows>
        </visual>
        <collision name='collision'>
          <laser_retro>0</laser_retro>
          <max_contacts>10</max_contacts>
          <!-- ★ 2027 场地（RMUL2027_3V3_V1.0.0.stp → gmsh 200 mm 三角化 → 二进制 STL）：
               与 RMUL2026 同一套约定，只有三处不同（推导/实测见 docs/worlds.md §9）：
                 · mesh 单位 mm ⇒ <scale>0.001；mesh 是 Y 轴朝上 ⇒ 绕 X 转 -90°（此处用精确的
                   -1.5707963，而 2026 那份写 -1.5705，差 0.3 mrad ≈ 全场 1.3 mm 倾斜，2027 这份不再引入）；
                 · mesh 的**可行驶地面**就是局部 y=0 平面（12600x8600 mm 里 5704/10836 个
                   0.1 m 栅格点顶层落在 y=0，另有 y=-3/-10 的 3~10 mm 薄装饰面）；
                   y 是**朝下**的（+y = 地面以下：100 mm 厚的底板底面在 y=+100，全部 108.36 m²；
                   场地立墙/台阶在地面**之上**，y 到 -420）。旋转后 world z = -y·0.001
                   ⇒ y=0 地面正好落在 z=0，**不需要任何 z 偏移**（model pose z 与 link pose z 都是 0）；
                 · 场地中心放在世界原点（mesh x → world x，mesh z → world y），
                   world 外框 x∈[-6.3,6.3]、y∈[-4.3,4.3]，与 RMUC2026 的"mesh 米制坐标==world 坐标"一致。
               本 world 文件里**内联**的这份是实际生效的资产；`model.sdf` 是 model://RMUL2027_world 的
               独立入口，两者数值一致。 -->
          <pose>0 0 0 -1.5707963 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://RMUL2027_world/meshes/RMUL2027.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <fdir1>0 0 0</fdir1>
                <slip1>0</slip1>
                <slip2>0</slip2>
              </ode>
              <torsional>
                <coefficient>1</coefficient>
                <patch_radius>0</patch_radius>
                <surface_radius>0</surface_radius>
                <use_patch_radius>1</use_patch_radius>
                <ode>
                  <slip>0</slip>
                </ode>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0</restitution_coefficient>
              <threshold>1e+06</threshold>
            </bounce>
            <contact>
              <collide_without_contact>0</collide_without_contact>
              <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
              <collide_bitmask>1</collide_bitmask>
              <ode>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+13</kp>
                <kd>1</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0</min_depth>
              </ode>
              <bullet>
                <split_impulse>1</split_impulse>
                <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+13</kp>
                <kd>1</kd>
              </bullet>
            </contact>
          </surface>
        </collision>
      </link>
      <static>1</static>
      <allow_auto_disable>1</allow_auto_disable>
      <!-- 核心修改：x改为8.5，y保持4.5 -->
      <pose>0 0 0 0 0 0</pose>
    </model>
    <!-- ★ 2027-10-28：场地四周的静态围栏（真实赛场 1~3 m 高度上那一圈边界结构，
         见 docs/worlds_2027.md §9）。centerline / 立柱 / 横杆参数全部由
         tools/scripts/world/perimeter_fence.py 生成，这里只做 include。 -->
    <include>
