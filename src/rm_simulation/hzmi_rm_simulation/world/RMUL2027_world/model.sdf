<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- RMUL2027 场地模型（独立 model 入口，供 model://RMUL2027_world 直接 include；
       与 world/RMUL2027_world/RMUL2027_world.world 里内联的那份等价）。
       结构镜像 RMUL2026_world/model.sdf，差异只有三处（依据见 docs/worlds.md §9）：
         1. mesh 单位是毫米 ⇒ scale 0.001（RMUL2026 的 model.sdf 那份写 0.01 是错的/未生效；
            这里 world 内联与 model.sdf 两处都写 0.001）
         2. mesh 是 Y 轴朝上、且 y 朝**下**（+y = 地面以下）⇒ 绕 X 转 -90°（精确 -1.5707963，
            不用 2026 那份的 -1.5705，避免 0.3 mrad ≈ 全场 1.3 mm 的倾斜）
         3. 可行驶地面就是 mesh 局部 y=0 平面 ⇒ 旋转后正好落在 world z=0，pose 的 z 是 0 -->
  <model name='RMUL2027_world'>
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>

    <link name='base_link'>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>100.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>100.0</iyy>
          <iyz>0.0</iyz>
          <izz>100.0</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>

      <pose>0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <enable_wind>false</enable_wind>

      <visual name='visual'>
        <pose>0 0 0 -1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUL2027_world/meshes/RMUL2027.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>true</cast_shadows>
      </visual>

      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 -1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUL2027_world/meshes/RMUL2027.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
