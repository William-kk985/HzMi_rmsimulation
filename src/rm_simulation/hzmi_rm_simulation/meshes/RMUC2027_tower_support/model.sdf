<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- RMUC2027_tower_support —— 把中央塔"断掉的那一段"接回地面（2026-10-29 追加）。

       量出来的事实（docs/worlds_2027.md §9.7，全部从 RMUC2027.stl 上测）：
         · 塔是**斜桁架**：两根主斜撑，上段截面中心在 (∓0.51, 1.56/1.68)、下段在 (∓0.36, 1.57/1.68)
           （上段比下段**向外偏 0.15 m**，因为斜撑是外张的）；
         · 下段最高到 world z = **1.50**，上段最低从 world z = **1.86** 起 ⇒ 中间 **0.36 m 真空**
           （柱体内 1.50~1.86 没有任何面、连通分量也不相连 ⇒ 不是"细杆被网格吃掉"，是真断口）；
         · 塔脚下方的地面：塔心 (0,1.62) 竖直射线命中 0.22（中央 0.2 m 高地）/ 0.05（场地地面）
           ⇒ 塔本身站在中央高地上、是落地的，**唯一悬空的就是 1.50~1.86 这一段**。

       支撑几何（4 个盒子，全部落在塔的投影里，不额外侵占可行驶区）：
         · 2 根方柱 0.16(x) × 0.12(y) × 0.52(z)，中心 (∓0.435, 1.565/1.675, 1.66)
           ⇒ z 1.40~1.92：**下端埋进下段斜撑 0.10 m、上端顶进上段斜撑 0.06 m**，
           横向正好把 (∓0.36) 与 (∓0.51) 两个端点都包住（x 覆盖 ∓0.515~∓0.355）；
         · 2 根横撑 0.06×1.00×0.06 @ z=1.62 / 1.80，把左右两根方柱连成一个整体（H 形框架）；
         · 没有做斜撑：断口只有 0.36 m，斜撑在这个尺度上既不真实也看不出。
       材质/物理与场地一致：Gazebo/Grey、static、mu=1；**不改场地 mesh、不改围栏、不改出生点**。
       尺寸依据见 docs/worlds_2027.md §9.7。 -->
  <model name='RMUC2027_tower_support'>
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>
    <pose>0 0 0 0 0 0</pose>
    <link name='support'>
      <inertial>
        <mass>1000.0</mass>
        <inertia><ixx>100.0</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>100.0</iyy><iyz>0.0</iyz><izz>100.0</izz></inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <pose>0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <enable_wind>false</enable_wind>

      <collision name='post_l_col'>
        <max_contacts>10</max_contacts>
        <pose>-0.435 1.565 1.660 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.52</size></box></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e+06</threshold></bounce></surface>
      </collision>
      <visual name='post_l_vis'>
        <pose>-0.435 1.565 1.660 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.52</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          <ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse><specular>0.05 0.05 0.05 1</specular><emissive>0 0 0 1</emissive></material>
        <cast_shadows>1</cast_shadows>
      </visual>

      <collision name='post_r_col'>
        <max_contacts>10</max_contacts>
        <pose>0.435 1.675 1.660 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.52</size></box></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e+06</threshold></bounce></surface>
      </collision>
      <visual name='post_r_vis'>
        <pose>0.435 1.675 1.660 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.52</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          <ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse><specular>0.05 0.05 0.05 1</specular><emissive>0 0 0 1</emissive></material>
        <cast_shadows>1</cast_shadows>
      </visual>

      <collision name='brace_a_col'>
        <max_contacts>10</max_contacts>
        <pose>0.0 1.620 1.620 0 0 0</pose>
        <geometry><box><size>1.00 0.06 0.06</size></box></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e+06</threshold></bounce></surface>
      </collision>
      <visual name='brace_a_vis'>
        <pose>0.0 1.620 1.620 0 0 0</pose>
        <geometry><box><size>1.00 0.06 0.06</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          <ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse><specular>0.05 0.05 0.05 1</specular><emissive>0 0 0 1</emissive></material>
        <cast_shadows>1</cast_shadows>
      </visual>

      <collision name='brace_b_col'>
        <max_contacts>10</max_contacts>
        <pose>0.0 1.620 1.800 0 0 0</pose>
        <geometry><box><size>1.00 0.06 0.06</size></box></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e+06</threshold></bounce></surface>
      </collision>
      <visual name='brace_b_vis'>
        <pose>0.0 1.620 1.800 0 0 0</pose>
        <geometry><box><size>1.00 0.06 0.06</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          <ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse><specular>0.05 0.05 0.05 1</specular><emissive>0 0 0 1</emissive></material>
        <cast_shadows>1</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
