<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- RMUC2027 场地模型（独立 model 入口，供 model://RMUC2027_world 直接 include；
       与 world/RMUC2027_world/RMUC2027_world.world 里内联的那份等价）。
       结构镜像 RMUC2026_world/model.sdf，差异（2027-10-29 换新 STL 后，依据见 docs/worlds_2027.md §9.8）：
         1. mesh 单位是毫米 ⇒ scale 0.001
         2. mesh 已经是世界系（Z 朝上、可行驶地面在 z=0、场地 x±14000）⇒ **不需要旋转、不需要抬升**，
            pose 是 (0,0,0)（旧 STL 那份是 +1.700）
         3. 塔的上段（原 1.86~3.56 m）已被整体下移 0.959 m 并进 mesh，塔顶 3.56 → 2.60 m（网格最高点 2.92 m）-->
  <model name='RMUC2027_world'>
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>

    <link name='base_link'>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>100.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>100.0</iyy>
          <iyz>0.0</iyz>
          <izz>100.0</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>

      <pose>0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <enable_wind>false</enable_wind>

      <visual name='visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUC2027_world/meshes/RMUC2027.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>true</cast_shadows>
      </visual>

      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RMUC2027_world/meshes/RMUC2027.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
