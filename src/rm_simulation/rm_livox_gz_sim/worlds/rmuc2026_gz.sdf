<?xml version="1.0" ?>
<!-- =============================================================================
     rmuc2026_gz.sdf —— **整栈世界**：场 + robot11（真碰撞几何）+ 倾斜的 MID-360
     =============================================================================
     机器人那一份不是写死在这里的 SDF：`model://rm_robot11_gz` 是 launch 在运行期
     从**同一份 URDF**（bringup 的 robot_description）生成的：
         xacro -> URDF -> [preserveFixedJoint] -> ign sdf -p -> 后处理
     见 scripts/make_robot_gz_sdf.py。为什么这么做：
       · 几何/碰撞/惯量与 Classic **同一真源**（robot11 有 113 个真碰撞体），
         改 URDF 不会出现「经典档和 gz 档模型不一样」；
       · 生成时把 `<link><pose>` 里的 fixed joint 折平，`livox_frame` 的 pose 就带
         上了 roll -0.5236 —— 即 B① 决策要的「物理倾斜」；
       · 生成时剥掉 Classic 插件块（libros2_livox.so / libgazebo_ros_*.so），
         换成我们的两个 mid360 实例 + 一个 gz IMU 传感器。

     `<static>true</static>`？模型生成时带 `<static>true</static>`：
       · 本后端的验收范围是「感知契约 + 端到端 LIO」，**不含底盘运动学**；
       · robot11 的 URDF 里没有任何轮子关节（j2..j9 是云台/炮管，不是轮），Classic
         侧本来就是 libgazebo_ros_planar_move.so 直接给 Model 设速度，Fortress 没有
         对应实现 ⇒ 走「静态底座」是诚实的下限，写进未实现清单。
     ============================================================================= -->
<sdf version="1.9">
  <world name="rmuc2026_gz">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <plugin filename="librmagine_embree_map_system.so"
            name="rmagine_gazebo_plugins::RmagineEmbreeMapSystem">
      <update>
        <rate_limit>30</rate_limit>
        <delta_trans>0.001</delta_trans>
        <delta_rot>0.001</delta_rot>
      </update>
      <debug>true</debug>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://RMUC2026_world</uri>
      <static>true</static>
      <name>RMUC2026</name>
    </include>

    <!-- 出生点 (10.925, 2.525) 与 Classic RMUC2026 完全一致（rm_simulation.launch.py 的
         WorldType.RMUC2026）。z = 0.1025 = base_link 原点离地高度（地面在 base_link
         z = -0.102499，见 docs/tilted_lidar_fidelity.md §J/§K）；Classic 用 z=0.2 让车
         「落一下」，本后端静态 ⇒ 直接落到位，避免开局一段坠落污染 LIO 的重力初始化。 -->
    <include>
      <uri>model://rm_robot11_gz</uri>
      <name>robot11</name>
      <pose>10.925 2.525 0.1025 0 0 0</pose>
    </include>

    <!-- ⚠️ 自机排除：**不靠**这里的任何配置。插件的 Configure 会
         MapRegistry::AddIgnoredModelEntity(<它所属的 model 实体>)，
         rmagine_embree_map_system 在建树时按祖先链剔除 ⇒ robot11 的 113 个碰撞体
         不进 BVH。实测证据（有/无排除的 A/B）见 docs/fortress_sim_backend.md。 -->
  </world>
</sdf>
