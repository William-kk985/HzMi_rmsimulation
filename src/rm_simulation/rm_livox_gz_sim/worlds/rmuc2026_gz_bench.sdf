<?xml version="1.0" ?>
<!-- =============================================================================
     rmuc2026_gz_bench.sdf —— **台架世界**（只有传感器，没有机器人）
     =============================================================================
     用途：契约/性能测量的可复现环境（docs/fortress_sim_backend.md 里所有
     「30000 rays @ 10 Hz」「median 点数」「双实例耗时」「offset_time」数字都是这个
     世界 + `world:=RMUC2026 sim_backend:=gz gz_robot:=none` 跑出来的）。

     与 Classic `.world`（SDF 1.7，ODE）的差别：
       · <sdf version="1.9">：Fortress 的 sdformat12 **只认到 1.9**，1.10 会让
         「整个世界加载失败、一帧点云都不出」（实测见 livox_sensor_prior_art.md §10.4.6）。
       · physics 用 ignition 的 physics system（没有 ODE 参数了），1 ms 步长保留。
       · 没有 camera / gpu_ray 传感器 ⇒ GUI 只是多画一个视图，对 RTF 影响 ≈0。

     场地：真 RMUC2026.stl（45,900 面，mm，<scale>0.001，z 抬 1.6413436）由
     `model://RMUC2026_world` 引入（launch 负责把 install/hzmi_rm_simulation/share/
     hzmi_rm_simulation/meshes 塞进 GZ_SIM_RESOURCE_PATH）。
     ============================================================================= -->
<sdf version="1.9">
  <world name="rmuc2026_gz_bench">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <!-- ── BVH：**整个世界一个实例**，按 <collision> 建一次 Embree 场景，
            然后放进 MapRegistry（key = default）。所有传感器实例共用它。
            <update> 里的 delta_* 是「模型动了多少才 refit」的阈值 —— 这就是
            「动态障碍 refit」那条路径。 -->
    <plugin filename="librmagine_embree_map_system.so"
            name="rmagine_gazebo_plugins::RmagineEmbreeMapSystem">
      <update>
        <rate_limit>30</rate_limit>
        <delta_trans>0.001</delta_trans>
        <delta_rot>0.001</delta_rot>
      </update>
      <debug>true</debug>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://RMUC2026_world</uri>
      <static>true</static>
      <name>RMUC2026</name>
    </include>

    <!-- 传感器放在 RMUC2026 的出生点、robot11 的雷达离地高度（0.2595 m），
         与 robot11 上那一份<b>完全同姿态同位置</b> ⇒ 两边点云可以直接逐点比。 -->
    <include>
      <uri>model://rm_mid360_gz</uri>
      <name>rm_mid360_gz</name>
      <pose>10.925 2.525 0.2595 0 0 0</pose>
    </include>
  </world>
</sdf>
