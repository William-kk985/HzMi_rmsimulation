<?xml version="1.0" ?>
<model>
  <name>rm_mid360_gz</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>HzMi</name>
    <email>hzmi@example.com</email>
  </author>
  <description>
    Livox MID-360 CPU-ray sensor for Gazebo Fortress (ignition-gazebo6), bench variant.
    Two plugin instances on ONE tilted link: /livox/lidar (CustomMsg) and
    /livox/lidar/pointcloud (PointCloud2). The sensor system itself is third-party
    (ashduwihch/mid360_gazebo_harmonic @497149a, MIT) and is fetched + patched by
    tools/scripts/gzsim/fetch_and_patch_mid360.sh, not vendored in this repo.
    See docs/fortress_sim_backend.md.
  </description>
</model>
