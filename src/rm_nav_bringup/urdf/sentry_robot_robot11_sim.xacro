    </collision>
    <collision>
      <origin xyz="0.000000 0.247500 0.036479" rpy="0 0 0" />
      <geometry><box size="0.210000 0.015000 0.015350" /></geometry>
    </collision>
    <collision>
      <origin xyz="0.000000 0.187500 0.082528" rpy="0 0 0" />
      <geometry><box size="0.210000 0.015000 0.015350" /></geometry>
    </collision>
    <collision>
      <origin xyz="-0.105000 0.112500 0.113227" rpy="0 0 0" />
      <geometry><box size="0.180000 0.015000 0.015350" /></geometry>
