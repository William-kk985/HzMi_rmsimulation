  <!-- ==================== link livox_frame ==================== -->
  <link name="livox_frame">
    <!-- 【上游原样】inertial -->
    <inertial>
      <origin xyz="-0.000348524070196802 0.00208606529928732 0.0221378690951775" rpy="0 0 0" />
      <mass value="0.13998133026592" />
      <inertia ixx="4.17032187760686E-05" ixy="-5.98077892665089E-09" ixz="3.05517185056836E-07" iyy="4.50191700802289E-05" iyz="-5.90930308926011E-10" izz="6.87178468496533E-05" />
    </inertial>
    <!-- 【上游原样】visual（几何位置/单位/材质逐字照抄；mesh 文件按 `visual_dir` 换档，见文件头 Phase 5） -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://robot11/${visual_dir}/l12${visual_ext}" /></geometry>
      <material name=""><color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" /></material>
    </visual>
    <!-- 【我们加的｜替换】上游这里是 mesh collision；按 Phase 1 实测换掉（原因见文件头） -->
    <!-- livox_frame：**故意不给 collision**（射线传感器就在本 link 原点上，给碰撞体 = 每条射线打自己；实测见 docs/robot_models.md §10.5） -->
  </link>

  <!-- ==================== joint j2 ==================== -->
  <!-- 【上游原样】 -->
