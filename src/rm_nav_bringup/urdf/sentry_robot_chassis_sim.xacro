  <!-- ===================== 仿真附加（原 URDF 没有；其余逐字节不动）===================== -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <parent link="base_link"/><child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="chassis_imu" type="imu">
      <always_on>true</always_on><update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros><namespace>/</namespace><remapping>~/out:=/livox/imu</remapping></ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro"/>
  <xacro:mid360 name="livox_frame" parent="base_link" topic="/livox/lidar">
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </xacro:mid360>
  <gazebo>
    <plugin name="diff_drive_front" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel_chassis</remapping>
        <remapping>odom:=odom_ground_truth</remapping></ros>
      <update_rate>100</update_rate>
      <left_joint>w1</left_joint>
      <right_joint>w2</right_joint>
      <wheel_separation>0.281</wheel_separation>
      <wheel_diameter>0.116</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="diff_drive_rear" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel_chassis</remapping></ros>
      <update_rate>100</update_rate>
      <left_joint>w3</left_joint>
      <right_joint>w4</right_joint>
      <wheel_separation>0.281</wheel_separation>
      <wheel_diameter>0.116</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
  </gazebo>

  <!-- 轮子对地摩擦：与 robot11 同款（固定轮 + planar_move 的组合）——
       默认 μ=1 时轮子"抓住"地面，planar_move 直接推底盘会在斜坡/台阶处产生倾覆力矩（翻车）；
       降到 μ=0.02 ⇒ 轮子滑动、底盘被速度直接推上去 ⇒ 不翻。只改摩擦，不改几何。 -->
  <gazebo reference="w1"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="w2"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="w3"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="w4"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>

  <!-- 颜色：车体黑、轮子深灰（Gazebo 渲染用；URDF 的 <visual> 材质给 RViz）-->
  <gazebo reference="base_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="w1"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="w2"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="w3"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="w4"><material>Gazebo/DarkGrey</material></gazebo>

</robot>