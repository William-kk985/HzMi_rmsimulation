  <!-- 仿真附加（原 URDF 没有；几何/惯量/碰撞一律不动）-->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <parent link="base_link"/><child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="chassis_imu" type="imu">
      <always_on>true</always_on><update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros><namespace>/</namespace><remapping>~/out:=/livox/imu</remapping></ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro"/>
  <!-- ★ 2026-10-30：雷达**物理倾斜 45° 下俯**（与实车一致）——与 robot11 同款"物理/数据两层"：
       ① livox_physical：物理安装位置（rpy=-45° 下俯），**射线传感器挂这里** ⇒ 插件发
          /livox/lidar_raw（点表达在**斜的**物理系）；
       ② livox_frame：**水平的数据帧**（rpy=0），只做 TF 锚点；
       ③ launch 里的 livox_cloud_extrinsic 用 TF(livox_frame←livox_physical) 把点云旋正 →
          /livox/lidar（frame_id=livox_frame）⇒ 下游（linefit/patchwork/LIO）看到的仍是水平点云。 -->
  <xacro:mid360 name="livox_physical" parent="base_link" topic="/livox/lidar_raw">
    <origin xyz="0 0 0.09" rpy="-0.78539816 0 0"/>
  </xacro:mid360>
  <!-- 水平数据帧（与物理雷达同位置，rpy=0；无 visual）-->
  <link name="livox_frame"/>
  <joint name="livox_frame_joint" type="fixed">
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <parent link="base_link"/><child link="livox_frame"/>
  </joint>
  <gazebo>
    <plugin name="mecanum_controller" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel_chassis</remapping>
        <remapping>odom:=odom_ground_truth</remapping></ros>
      <update_rate>100</update_rate><publish_rate>10</publish_rate>
      <publish_odom>true</publish_odom><publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.0001</covariance_x><covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="w1"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="w2"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="w3"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="w4"><material>Gazebo/DarkGrey</material></gazebo>

  <!-- 轮子对地摩擦 0.02（robot11 同款）：固定轮+planar_move 时，默认 μ=1 会让轮子"抓地"
       而在加速/急转/坡道产生倾覆力矩（翻车）；0.02 让轮子滑动、底盘被速度直接推 ⇒ 不翻。 -->
  <gazebo reference="w1"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  <gazebo reference="w2"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  <gazebo reference="w3"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  <gazebo reference="w4"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>

</robot>